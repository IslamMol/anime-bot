# Скопируй в .env и впиши свои значения. Настоящий .env в git не попадает.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYours
BOT_USERNAME=@YourBotName
CHANNEL_ID=-1000000000000
WEBAPP_URL=https://your-domain.example
# абсолютный путь рекомендуется, чтобы бот и парсер видели одну базу
DB_PATH=/opt/anime-telegram-bot/data/bot.db
# твой Telegram user id (узнать: @getmyid_bot). Пусто = команды /stats и /post закрыты.
ADMIN_IDS=123456789
