# Скопируй в .env и впиши свои значения. Настоящий .env в git не попадает.
BOT_TOKEN=123456789:AAExampleTokenReplaceMeWithYours
BOT_USERNAME=@YourBotName
CHANNEL_ID=-1000000000000
WEBAPP_URL=https://your-domain.example
# Путь к базе. Можно оставить относительным (считается от корня проекта) —
# так одинаково работает и на Windows, и на Linux. Абсолютный путь задавай,
# только если он реально абсолютный на этой системе: /opt/... на Windows
# развернется в D:\проект\opt\... и создаст лишние папки.
DB_PATH=./data/bot.db
# твой Telegram user id (узнать: @getmyid_bot). Пусто = команды /stats и /post закрыты.
ADMIN_IDS=123456789
