# Playwright CLI output (may contain credentials)
.playwright-cli/

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Secrets — никогда не коммитить
anime-telegram-bot/.env
anime-telegram-bot/.env.*
!anime-telegram-bot/.env.example

# Локальная SQLite и её WAL-файлы
anime-telegram-bot/data/*.db
anime-telegram-bot/data/*.db-wal
anime-telegram-bot/data/*.db-shm

# Байткод
__pycache__/
*.pyc

# Локальная база (избранное живет только на машине/раннере)
# исключения — файлы, которые Actions коммитит обратно:
# posted.json (журнал постов), subscriptions.json (подписки),
# epcounts.json (счетчики серий для уведомлений)
anime-telegram-bot/data/*
!anime-telegram-bot/data/posted.json
!anime-telegram-bot/data/subscriptions.json
!anime-telegram-bot/data/epcounts.json
!anime-telegram-bot/data/tracked.json
